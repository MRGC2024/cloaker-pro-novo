# Copie para .env na máquina local. No Railway, defina as mesmas chaves em Variables.
# Não commite o .env.

PORT=3000
NODE_ENV=production
SESSION_SECRET=troque-por-um-segredo-longo

# PostgreSQL (Supabase ou Railway). Sem isso o painel usa SQLite local.
DATABASE_URL=

# Host que pode abrir o painel, sem https://
PANEL_DOMAIN=

# Origens extras do CORS, separadas por vírgula
CORS_ORIGINS=

# Destino CNAME mostrado em Domínios. Só vale se terminar em .railway.app
APP_CNAME_TARGET=

# Publicar e remover domínio customizado sem abrir o painel da Railway
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# Opcional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SETUP_RECOVERY_TOKEN=
BACKUP_WEBHOOK_URL=
VISITOR_RETENTION_DAYS=90
RATE_LIMIT_ENABLED=1
